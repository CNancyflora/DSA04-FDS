import numpy as np
from scipy import stats

drug = [12,15,10,14,13,16,11,15,12,14]
placebo = [5,7,4,6,8,5,6,7,4,5]

for x in [drug, placebo]:
    ci = stats.t.interval(0.95, len(x)-1,
                           loc=np.mean(x),
                           scale=stats.sem(x))
    print("Mean =", np.mean(x))
    print("95% CI =", ci)
