import pandas as pd
import matplotlib.pyplot as plt
import string
from collections import Counter

# Load dataset
df = pd.read_csv("data.csv")

# Stop words
stop_words = {'the', 'and', 'is', 'a', 'an', 'to', 'of', 'in', 'for'}

# Combine feedback
text = ' '.join(df['feedback'].astype(str))

# Convert to lowercase
text = text.lower()

# Remove punctuation
text = text.translate(str.maketrans('', '', string.punctuation))

# Split into words
words = text.split()

# Remove stop words
words = [word for word in words if word not in stop_words]

# Frequency distribution
frequency = Counter(words)

# Get N from user
N = int(input("Enter the value of N: "))

# Top N words
top_words = frequency.most_common(N)

print("\nTop", N, "Most Frequent Words:")
for word, count in top_words:
    print(word, ":", count)

# Plot bar graph
words_list = [x[0] for x in top_words]
counts = [x[1] for x in top_words]

plt.bar(words_list, counts)
plt.xlabel("Words")
plt.ylabel("Frequency")
plt.title("Top N Most Frequent Words")
plt.xticks(rotation=45)
plt.show()
