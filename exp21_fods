import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats

df = pd.DataFrame({
    "Age":[23,25,28,30,32,35,38,40,42,45,47,50,52,55,58,60,62,65],
    "Fat":[12,15,18,20,22,24,26,25,28,30,31,33,35,36,38,40,41,43]
})

print(df.mean())
print(df.median())
print(df.std())

df.boxplot()
plt.show()

plt.scatter(df.Age, df.Fat)
plt.xlabel("Age")
plt.ylabel("Fat %")
plt.show()

stats.probplot(df.Age, dist="norm", plot=plt)
plt.show()

stats.probplot(df.Fat, dist="norm", plot=plt)
plt.show()
